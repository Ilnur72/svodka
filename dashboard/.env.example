# API манзиллари. Нусхаланг: cp .env.example .env
#
# Локал бэкенд:
VITE_API_BASE=http://localhost:8085/production-report
VITE_AUTH_BASE=http://localhost:8085
#
# Продакшн (ўз хостингизни ёзинг):
# VITE_API_BASE=https://<host>/api/production-report
# VITE_AUTH_BASE=https://<host>/api
#
# Эслатма: бу файлга ҳеч қандай махфий қиймат (токен, парол, калит) ёзилмайди —
# Vite `VITE_*` ўзгарувчиларини build ичига қўшади. Токен фақат ишчи сеансда
# sessionStorage'да сақланади.
